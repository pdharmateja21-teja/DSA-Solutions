import java.util.Scanner;

class GFG {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        // Read the number of rows for the pattern
        int n = sc.nextInt();

        // -------------------- Upper Half --------------------
        // Prints a pyramid with rows increasing from 1 to n
        for (int i = 0; i < n; i++) {

            // Print leading spaces to center-align the stars
            for (int j = 0; j < n - i - 1; j++) {
                System.out.print(" ");
            }

            // Print stars for the current row
            // Number of stars = i + 1
            for (int j = 0; j <= i; j++) {
                System.out.print("* ");
            }

            // Move to the next line after completing the row
            System.out.println();
        }

        // -------------------- Lower Half --------------------
        // Prints an inverted pyramid with rows decreasing from n to 1
        for (int i = n - 1; i >= 0; i--) {

            // Print leading spaces to keep the pattern centered
            for (int j = 0; j < n - i - 1; j++) {
                System.out.print(" ");
            }

            // Print stars for the current row
            // Number of stars = i + 1
            for (int j = 0; j <= i; j++) {
                System.out.print("* ");
            }

            // Move to the next line
            System.out.println();
        }
    }
}

class Solution {
    public int subtractProductAndSum(int n) {

        // Variable to store the sum of all digits.
        int sum = 0;

        // Variable to store the product of all digits.
        // Initialized to 1 because 1 is the multiplicative identity.
        int product = 1;

        // Process each digit of the number until no digits are left.
        while (n > 0) {

            // Extract the last digit of the number.
            // Example:
            // n = 234
            // digit = 234 % 10 = 4
            int digit = n % 10;

            // Add the extracted digit to the running sum.
            sum = sum + digit;

            // Multiply the extracted digit with the running product.
            product = product * digit;

            // Remove the last digit from the number.
            // Example:
            // n = 234
            // n = 234 / 10 = 23
            n = n / 10;
        }

        // Return the difference between
        // the product of digits and the sum of digits.
        return product - sum;
    }
}

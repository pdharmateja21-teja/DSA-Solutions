import java.util.Scanner;

class GFG {
    public static void main(String[] args) {

        // Create a Scanner object to read input from the user.
        Scanner sc = new Scanner(System.in);

        // Read the number whose multiplication table is to be printed.
        int n = sc.nextInt();

        // Run the loop from 1 to 10.
        // Each iteration prints one multiple of the given number.
        for (int i = 1; i <= 10; i++) {

            // Multiply the given number by the current value of i
            // and print the result followed by a space.
            //
            // Example:
            // n = 5
            // i = 1 → 5 × 1 = 5
            // i = 2 → 5 × 2 = 10
            // i = 3 → 5 × 3 = 15
            // ...
            // i = 10 → 5 × 10 = 50
            System.out.print(n * i + " ");
        }

        // Close the Scanner to free system resources.
        sc.close();
    }
}
